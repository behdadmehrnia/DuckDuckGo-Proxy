# Server
HOST=0.0.0.0
PORT=8080

# Optional Bearer token. When set, clients must send:
#   Authorization: Bearer <API_KEY>
# Leave empty to disable auth (fine for local / private networks).
API_KEY=

# Search defaults (max_results is clamped to 1–10)
DEFAULT_MAX_RESULTS=5
SEARCH_TIMEOUT_SEC=8
SAFESEARCH=moderate
REGION=wt-wt

# Comma-separated ddgs backends (tried in order).
# Options: duckduckgo, bing, brave, google, wikipedia, yahoo, yandex, …
BACKENDS=duckduckgo

# Set false if upstream TLS fails due to a corporate SSL-inspecting proxy.
VERIFY_SSL=true
